# =============================================================================
# Food Ordering App — Environment Variables
# Copy this file to `.env.local` for local development.
# Add the same keys in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled connection — use for app runtime queries (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Direct connection — use for migrations (`npx prisma migrate deploy`)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret"

# Local: http://localhost:3000 | Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# App URL (required for Stripe checkout redirects, SEO, sitemap)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Test keys for local dev (sk_test_...). Live keys (sk_live_...) for production.
STRIPE_SECRET_KEY="sk_test_..."

# From Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_...)
# Cart checkout: point webhook to /api/webhooks/stripe (checkout.session.completed)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Local dev only — set to "true" to simulate payments without real Stripe charges.
# Do NOT set in Vercel production.
# STRIPE_SIMULATION_MODE="true"

# -----------------------------------------------------------------------------
# Cloudinary (admin product image uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# Pusher (optional — real-time order status updates)
# -----------------------------------------------------------------------------
# PUSHER_APP_ID="your-app-id"
# PUSHER_KEY="your-key"
# PUSHER_SECRET="your-secret"
# PUSHER_CLUSTER="eu"
# NEXT_PUBLIC_PUSHER_KEY="your-key"
# NEXT_PUBLIC_PUSHER_CLUSTER="eu"
