generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  image       String
  order       String
  basePrice   Float
  createdat   DateTime @default(now())
  updateAt    DateTime @updatedAt
}
