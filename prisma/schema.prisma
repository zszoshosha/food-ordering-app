generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           String          @id @default(cuid())
  slug         String?         @unique
  name         String
  description  String
  image        String
  basePrice    Float
  updateAt     DateTime        @updatedAt
  category     ProductCategory @default(CLASSIC)
  categorySlug String?
  createdAt    DateTime        @default(now())
  order        Int
  extras       Extra[]
  orderItems   OrderItem[]
  sizes        Size[]

  @@index([category])
  @@index([categorySlug])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  address    String
  total      Float
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  productId String
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  password String
  role     UserRole  @default(USER)
  orders   Order[]
  accounts Account[]
  sessions Session[]
}

model Size {
  id        String      @id @default(cuid())
  name      ProductSize
  price     Float
  productId String
  product   Product     @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Extra {
  id        String          @id @default(cuid())
  name      Extraingredient
  price     Float
  productId String
  product   Product         @relation(fields: [productId], references: [id])

  @@index([productId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

enum UserRole {
  USER
  ADMIN
  DELIVERY
}

enum ProductSize {
  SMALL
  MEDIUM
  LARGE
}

enum ProductCategory {
  CLASSIC
  SPECIALTY
  VEGETARIAN
  MEAT
  SEAFOOD
}

enum Extraingredient {
  CHEESE
  BACON
  MUSHROOMS
  PEPPERS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
